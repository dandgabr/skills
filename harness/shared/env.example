# Variáveis de ambiente esperadas pelas configurações de harness deste repositório.
# NUNCA preencha valores reais aqui — este arquivo é documentação dos nomes de variáveis.

# AutoDoc MCP
AUTODOC_LOCALE=en-US
NODE_ENV=production

# Servidores MCP com autenticação (preencha fora deste arquivo)
API_KEY=
GITHUB_TOKEN=

# Exemplos de interpolação:
#   OpenCode:      {env:API_KEY}
#   Claude/Antigravity/Cline: ${API_KEY}
